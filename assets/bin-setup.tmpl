#!/bin/sh
set -e

echo "Setting up {{.RepoName}} for local development..."
echo ""

# Check Go
if ! command -v go >/dev/null 2>&1; then
    echo "Error: Go is not installed."
    echo "Install it from https://go.dev/dl/ or via:"
    echo "  brew install go"
    echo "  mise install go"
    exit 1
fi
echo "Go $(go version | awk '{print $3}') found."

# Install Go dependencies
echo "Installing Go dependencies..."
go mod download

# Install golangci-lint
if ! command -v golangci-lint >/dev/null 2>&1; then
    echo "Installing golangci-lint..."
    go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
else
    echo "golangci-lint found."
fi

# Configure git hooks
echo "Configuring git hooks..."
git config core.hooksPath .githooks

# Build
echo "Building {{.BinaryName}} binary..."
go build -o {{.BinaryName}} ./cmd/{{.BinaryName}}/

echo ""
echo "Setup complete. Run './{{.BinaryName}} --help' to get started."
echo "Run 'make install' to install globally to /usr/local/bin."
