version: 2

builds:
  - main: ./cmd/{{.BinaryName}}/
    binary: {{.BinaryName}}
    env:
      - CGO_ENABLED=0
    goos:
      - linux
      - darwin
      - windows
    goarch:
      - amd64
      - arm64
    ldflags:
      - -s -w
      - -X main.version={{"{{"}}.Version}}
      - -X main.commit={{"{{"}}.ShortCommit}}
      - -X main.date={{"{{"}}.Date}}

archives:
  - format: tar.gz
    format_overrides:
      - goos: windows
        format: zip
    name_template: "{{"{{"}} .ProjectName }}_{{"{{"}} .Version }}_{{"{{"}} .Os }}_{{"{{"}} .Arch }}"

blobs:
  - provider: s3
    bucket: "{{.S3Bucket}}"
    directory: "{{.S3PathPrefix}}/v{{"{{"}} .Version }}"

brews:
  - name: {{.BinaryName}}
    directory: Formula
    repository:
      owner: {{tapOwner .}}
      name: {{tapRepo .}}
      token: "{{"{{"}} .Env.TAP_GITHUB_TOKEN }}"
    commit_msg_template: "Brew formula update for {{"{{"}} .ProjectName }} version {{"{{"}} .Tag }}"
    url_template: "https://downloads.neeto.com/{{.S3PathPrefix}}/v{{"{{"}} .Version }}/{{"{{"}} .ArtifactName }}"
    homepage: "https://{{.Domain}}"
    description: "{{.RootShort}}"
    install: |
      bin.install "{{.BinaryName}}"

release:
  name_template: "v{{"{{"}} .Version }}"

checksum:
  name_template: "checksums.txt"

changelog:
  sort: asc
  filters:
    exclude:
      - "^docs:"
      - "^test:"
